{
  "name": "cortex",
  "version": "0.1.1",
  "description": "Cortex: local-first pentest intelligence hub. One SQLite memory shared by a pure stdio MCP server for agents, a ctx CLI and a desktop dashboard for humans.",
  "main": "./out/main/index.js",
  "bin": {
    "ctx": "./out/cli/ctx.cjs"
  },
  "author": "Revcloudi",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build && npm run build:mcp && npm run build:cli",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "dist:win": "node scripts/dist.mjs --win",
    "ctx": "node out/cli/ctx.cjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "install:agent": "node scripts/install-agent.mjs",
    "agent:dsh": "node out/cli/ctx.cjs init --yes --agents dsh",
    "agent:codex": "node out/cli/ctx.cjs init --yes --agents codex",
    "agent:claude": "node out/cli/ctx.cjs init --yes --agents claude",
    "agent:all": "node out/cli/ctx.cjs init --yes"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "chokidar": "3.6.0",
    "electron-log": "5.4.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.2",
    "cac": "7.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.65.0",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "smol-toml": "1.9.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
