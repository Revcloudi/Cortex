{
  "name": "@lievclouds/dsh-cortex",
  "version": "0.7.2",
  "description": "Cortex workbench for DeepSeek Harness: the original Cortex UI (vulnerabilities, assets, internal operations, Memory Nebula, snapshots, retest, mini-program reversing) as a native DSH panel, plus 22 native agent tools so DSH conversations use the local Cortex SQLite without MCP.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": {
    "name": "Revcloudi",
    "url": "https://github.com/Revcloudi"
  },
  "homepage": "https://github.com/Revcloudi/Cortex/tree/main/dsh-cortex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Revcloudi/Cortex.git",
    "directory": "dsh-cortex"
  },
  "bugs": {
    "url": "https://github.com/Revcloudi/Cortex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "asset-management",
    "cordis",
    "cortex",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "miniapp",
    "nebula",
    "pentest",
    "reverse-engineering",
    "sqlite",
    "vulnerability-management",
    "wechat-mini-program",
    "wxapkg"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build-host-graph.mjs && node scripts/build-cortex-ui.mjs",
    "build:graph": "node scripts/build-host-graph.mjs",
    "build:client": "node scripts/build-cortex-ui.mjs",
    "smoke": "node scripts/smoke-cortex-ui.mjs",
    "test": "node --test",
    "test:host": "node --test \"test/host/**/*.test.mjs\"",
    "pack:check": "npm pack --dry-run",
    "publish:npm": "npm publish --access public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "autoprefixer": "10.6.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "jsdom": "^31.0.0",
    "lucide-react": "1.65.0",
    "postcss": "8.5.32",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-force-graph-3d": "^1.29.2",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "3.4.19",
    "three": "^0.187.0",
    "zod": "4.6.7"
  },
  "dependencies": {
    "docx": "^9.15.3",
    "pdfkit": "^0.20.2"
  }
}
